{
  "name": "Budget Clair",
  "short_name": "Budget Clair",
  "description": "Analyse locale d'un relevé bancaire CSV : dépenses essentielles, utiles et superflues.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#edf1ee",
  "theme_color": "#0d3a2c",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            "text/csv",
            "text/plain",
            ".pdf",
            ".csv",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx"
          ]
        }
      ]
    }
  }
}
