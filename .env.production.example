# Copier ce fichier en ".env" (à la racine du dépôt, à côté de
# docker-compose.yml) sur le serveur, puis remplir les vraies valeurs.
# Ce fichier ".env" sert à la fois à Docker Compose (DOMAIN, POSTGRES_*) et
# à l'application (le reste, transmis au conteneur "web").

# Domaine sur lequel Caddy obtient un certificat HTTPS automatique.
DOMAIN=gemsofrod.com

# Identifiants de la base Postgres (conteneur "postgres" du docker-compose).
POSTGRES_USER=gemsofrod
POSTGRES_PASSWORD="change-me"
POSTGRES_DB=gemsofrod

# Doit correspondre aux valeurs POSTGRES_* ci-dessus. "postgres" est le nom
# du service dans docker-compose.yml (résolu par le réseau Docker interne).
DATABASE_URL="postgresql://gemsofrod:change-me@postgres:5432/gemsofrod"

# Secret de session NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET="change-me"

# Cloudinary (stockage des photos produits/articles) — compte gratuit sur
# https://cloudinary.com, identifiants dans le tableau de bord.
CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

# Premier compte administrateur, créé par "docker compose exec web npm run db:seed"
SEED_ADMIN_EMAIL="gemsofrod@gmail.com"
SEED_ADMIN_PASSWORD="changez-moi-immediatement"
