<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : même règle que backup_rules.xml (clé SumUp jamais sauvegardée ni transférée). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sumup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sumup.xml" />
    </device-transfer>
</data-extraction-rules>
