    <!-- Laboratório -->
    <string name="lab_menu_title">Laboratório</string>
    <string name="lab_menu_intro">Um espaço dedicado à identificação de pedras: formulário rápido, protocolo guiado passo a passo, instrumentos e léxico do gemólogo.</string>
    <string name="lab_quick_analysis_title">Análise rápida</string>
    <string name="lab_quick_analysis_subtitle">Preencha os critérios que você conhece, em qualquer ordem.</string>
    <string name="lab_guided_analysis_title">Análise guiada</string>
    <string name="lab_guided_analysis_subtitle">Um protocolo passo a passo, como um verdadeiro gemólogo.</string>
    <string name="guided_step_progress">Etapa %1$d / %2$d</string>
    <string name="guided_previous_button">Anterior</string>
    <string name="guided_next_button">Próximo</string>
    <string name="guided_finish_button">Ver resultados</string>
    <string name="guided_restart_button">Recomeçar a análise</string>
    <string name="guided_step_couleur_instruction">Observe a pedra sob luz neutra (idealmente luz do dia indireta), sobre um fundo branco. Anote o tom dominante — a cor percebida pode variar conforme a iluminação, evite portanto luz artificial quente ou lâmpadas coloridas.</string>
    <string name="guided_step_transparence_instruction">Segure a pedra diante de uma fonte de luz e observe se você distingue nitidamente os contornos de um objeto através dela (transparente), uma silhueta desfocada (translúcida), ou nada (opaca).</string>
    <string name="guided_step_eclat_instruction">Observe como a luz reflete na superfície polida da pedra: brilhante e vítreo como vidro, gorduroso como cera, ou metálico como um espelho. É um indício rápido sobre a natureza do material.</string>
    <string name="guided_step_clivage_instruction">Examine com uma lupa as eventuais fraturas internas. A clivagem se reconhece por planos lisos e brilhantes que seguem uma direção regular, ao contrário de uma fratura, que é irregular e vítrea.</string>
    <string name="guided_step_type_inclusion_instruction">Com uma lupa de 10x, procure inclusões características: agulhas sedosas, jardim de inclusões, halo ao redor de um cristal, estrutura fibrosa... Elas costumam ser o melhor indício para distinguir duas pedras de cor semelhante.</string>
    <string name="guided_step_durete_instruction">Com um kit de pontas de dureza (ou objetos de dureza conhecida como uma unha ≈2,5, uma lâmina de faca ≈5,5, uma lima de aço ≈6,5), determine a partir de qual grau a pedra começa a se riscar. Teste em uma face pouco visível.</string>
    <string name="guided_step_densite_instruction">Pese a pedra no ar e depois imersa em água, com uma balança hidrostática. A densidade relativa se calcula pela diferença entre as duas pesagens, em relação ao peso no ar.</string>
    <string name="guided_step_pleochroisme_instruction">Com um dicroscópio, observe a pedra sob vários ângulos: se as duas imagens justapostas mostram cores diferentes, a pedra é pleocroica.</string>
    <string name="guided_step_indice_refraction_instruction">Coloque a pedra sobre o prisma de um refratômetro com um líquido de contato. Leia o ângulo de reflexão total interna na escala graduada: quanto maior o índice, mais a pedra desvia a luz.</string>
    <string name="guided_step_systeme_cristallin_instruction">O polariscópio ajuda a determinar se a pedra é isotrópica (ela se apaga totalmente ao girar) ou anisotrópica. Combinado com a forma do cristal bruto, se disponível, isso orienta para um sistema cristalino preciso.</string>
    <string name="guided_step_fluorescence_instruction">No escuro, ilumine a pedra com uma lâmpada UV (ondas curtas e longas). Anote se ela emite um brilho visível, sua cor e intensidade — um indício adicional, especialmente para distinguir certos tratamentos.</string>

