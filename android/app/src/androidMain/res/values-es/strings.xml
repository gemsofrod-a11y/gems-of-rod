    <string name="legendary_map_instruction">Toque el país que alberga este yacimiento único.</string>
    <string name="legendary_wrong_country">Ese no es el país correcto. Inténtelo de nuevo.</string>
    <string name="legendary_success_title">¡El secreto está resuelto!</string>
    <string name="legendary_success_body">Ha encontrado Birmania (Myanmar), el único yacimiento conocido de painita en el mundo: la piedra considerada durante mucho tiempo el mineral gema más raro del planeta.</string>
