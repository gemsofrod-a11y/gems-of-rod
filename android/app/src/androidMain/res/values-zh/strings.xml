    <!-- 实验室 -->
    <string name="lab_menu_title">实验室</string>
    <string name="lab_menu_intro">专门用于宝石鉴定的空间：快速表单、逐步引导流程、仪器与宝石学词典。</string>
    <string name="lab_quick_analysis_title">快速分析</string>
    <string name="lab_quick_analysis_subtitle">按任意顺序填写您已知的条件。</string>
    <string name="lab_guided_analysis_title">引导式分析</string>
    <string name="lab_guided_analysis_subtitle">像真正的宝石学家一样，逐步进行分析。</string>
    <string name="guided_step_progress">第 %1$d / %2$d 步</string>
    <string name="guided_previous_button">上一步</string>
    <string name="guided_next_button">下一步</string>
    <string name="guided_finish_button">查看结果</string>
    <string name="guided_restart_button">重新开始分析</string>
    <string name="guided_step_couleur_instruction">在中性光线下（理想情况为间接日光）、白色背景前观察宝石。记录主色调——所感知的颜色可能因光源而异，因此应避免使用暖色人工光或彩色霓虹灯。</string>
    <string name="guided_step_transparence_instruction">将宝石置于光源前，观察您是否能清晰看到透过它的物体轮廓（透明）、模糊的轮廓（半透明），还是什么都看不到（不透明）。</string>
    <string name="guided_step_eclat_instruction">观察光线在宝石抛光表面的反射方式：如玻璃般明亮通透、如蜡般油润，或如镜面般呈金属光泽。这是快速判断材质性质的线索。</string>
    <string name="guided_step_clivage_instruction">用放大镜检查内部可能存在的裂纹。解理表现为沿规则方向延伸的平坦光亮平面，而断口则不规则且呈玻璃状。</string>
    <string name="guided_step_type_inclusion_instruction">使用 10 倍放大镜寻找特征性内含物：丝状针状体、内含物花园、晶体周围的晕圈、纤维状结构……它们往往是区分两种颜色相似宝石的最佳线索。</string>
    <string name="guided_step_durete_instruction">使用硬度测试笔套装（或已知硬度的物品，如指甲≈2.5、刀刃≈5.5、钢锉≈6.5），确定宝石开始被划伤的硬度等级。请在不显眼的表面进行测试。</string>
    <string name="guided_step_densite_instruction">用静水天平先在空气中称量宝石，再将其浸入水中称量。相对密度由两次称量之差与空气中重量的比值计算得出。</string>
    <string name="guided_step_pleochroisme_instruction">使用二色镜从多个角度观察宝石：如果两幅并列的图像显示不同颜色，则该宝石具有多色性。</string>
    <string name="guided_step_indice_refraction_instruction">将宝石放置在折射仪的棱镜上，并使用接触液。读取刻度上的全内反射角：折射率越高，宝石对光的偏折程度越大。</string>
    <string name="guided_step_systeme_cristallin_instruction">偏光镜有助于判断宝石是均质体（旋转时完全消光）还是非均质体。如有原石晶形可供参考，结合起来可确定具体的晶系。</string>
    <string name="guided_step_fluorescence_instruction">在黑暗环境中用紫外灯（短波与长波）照射宝石。记录是否发出可见荧光、其颜色与强度——这是区分某些处理方式的额外线索。</string>

