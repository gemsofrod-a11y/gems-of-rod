<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_anthracite">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_gradient"
            android:gravity="bottom"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTRE MAISON"
                android:textColor="@color/brand_gold"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textAllCaps="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/story_title"
                android:textColor="@color/brand_cream"
                android:textSize="26sp"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/story_subtitle"
                android:textColor="@color/brand_gray_medium"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Story Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/story_text_1"
                android:textColor="@color/brand_gray_medium"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.7"/>

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/brand_gold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/story_text_2"
                android:textColor="@color/brand_gray_medium"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.7"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/story_text_3"
                android:textColor="@color/brand_gray_medium"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.7"
                android:fontFamily="serif"
                android:textStyle="italic"/>

        </LinearLayout>

        <!-- Values Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/brand_anthracite_2"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nos valeurs"
                android:textColor="@color/brand_cream"
                android:textSize="20sp"
                android:fontFamily="serif"
                android:layout_marginBottom="20dp"/>

            <!-- Value 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/brand_anthracite_3"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="@color/brand_gold"
                    android:textSize="22sp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/story_value_1_title"
                        android:textColor="@color/brand_cream"
                        android:textSize="16sp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/story_value_1_desc"
                        android:textColor="@color/brand_gray_medium"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Value 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/brand_anthracite_3"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="◆"
                    android:textColor="@color/brand_gold"
                    android:textSize="22sp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/story_value_2_title"
                        android:textColor="@color/brand_cream"
                        android:textSize="16sp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/story_value_2_desc"
                        android:textColor="@color/brand_gray_medium"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Value 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/brand_anthracite_3"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="@color/brand_gold"
                    android:textSize="22sp"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/story_value_3_title"
                        android:textColor="@color/brand_cream"
                        android:textSize="16sp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/story_value_3_desc"
                        android:textColor="@color/brand_gray_medium"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
