<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_anthracite"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hero_section"
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:background="@drawable/bg_hero_gradient"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/hero_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_splash_gem"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="Logo"/>

            <TextView
                android:id="@+id/hero_brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/brand_cream"
                android:textSize="18sp"
                android:fontFamily="serif"
                app:layout_constraintStart_toEndOf="@+id/hero_logo"
                app:layout_constraintTop_toTopOf="@+id/hero_logo"
                app:layout_constraintBottom_toBottomOf="@+id/hero_logo"/>

            <!-- Hero content -->
            <TextView
                android:id="@+id/hero_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="@string/home_hero_title"
                android:textColor="@color/brand_cream"
                android:textSize="32sp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.25"
                app:layout_constraintBottom_toTopOf="@+id/hero_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hero_logo"
                app:layout_constraintVertical_chainStyle="packed"/>

            <TextView
                android:id="@+id/hero_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_hero_subtitle"
                android:textColor="@color/brand_gray_medium"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                app:layout_constraintBottom_toTopOf="@+id/hero_cta_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hero_title"/>

            <Button
                android:id="@+id/hero_cta_button"
                style="@style/Widget.GemsOfRod.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="32dp"
                android:text="@string/home_cta"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hero_subtitle"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Featured Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Gold ornament line -->
            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="@color/brand_gold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/featured_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SÉLECTION"
                android:textColor="@color/brand_gold"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textAllCaps="true"/>

            <TextView
                android:id="@+id/featured_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="@string/home_featured_title"
                android:textColor="@color/brand_cream"
                android:textSize="22sp"
                android:fontFamily="serif"/>

        </LinearLayout>

        <!-- Featured Products RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/featured_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        <!-- Values strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/brand_anthracite_2"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nos engagements"
                android:textColor="@color/brand_cream"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦"
                        android:textColor="@color/brand_gold"
                        android:textSize="20sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Authenticité"
                        android:textColor="@color/brand_cream"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chaque pierre est certifiée"
                        android:textColor="@color/brand_gray_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◆"
                        android:textColor="@color/brand_gold"
                        android:textSize="20sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rareté"
                        android:textColor="@color/brand_cream"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sélection exceptionnelle"
                        android:textColor="@color/brand_gray_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★"
                        android:textColor="@color/brand_gold"
                        android:textSize="20sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excellence"
                        android:textColor="@color/brand_cream"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service personnalisé"
                        android:textColor="@color/brand_gray_medium"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
