    <!-- Story -->
    <string name="story_title">Notre histoire</string>
    <string name="story_subtitle">L\'excellence au service de la beauté</string>
    <string name="story_text_1">Gems of Rod est né d\'une passion profonde pour les pierres précieuses et les gemmes d\'exception. Fondée par des experts passionnés, notre maison s\'est donnée pour mission de sélectionner avec soin les plus belles pierres du monde entier.</string>
    <string name="story_text_2">Chaque pierre que nous proposons est le fruit d\'une sélection rigoureuse, basée sur des critères d\'authenticité, de pureté et de brillance. Nous travaillons directement avec des mineurs et des fournisseurs de confiance pour vous garantir l\'origine et la qualité de chaque gemme.</string>
    <string name="story_text_3">Notre engagement va au-delà de la simple vente : nous vous accompagnons dans le choix de la pierre qui correspond à votre vision, à vos émotions, à votre histoire.</string>
    <string name="story_value_1_title">Authenticité</string>
    <string name="story_value_1_desc">Chaque pierre est certifiée et accompagnée de son rapport d\'expertise.</string>
    <string name="story_value_2_title">Rareté</string>
    <string name="story_value_2_desc">Nous sélectionnons uniquement des pierres d\'une qualité et d\'une rareté exceptionnelles.</string>
    <string name="story_value_3_title">Excellence</string>
    <string name="story_value_3_desc">Un service personnalisé et un accompagnement expert à chaque étape.</string>

