# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Jeton que l'app Android doit envoyer dans l'en-tête Authorization: Bearer <token>.
# Choisissez une chaîne longue et aléatoire, ex. `openssl rand -hex 32`.
ASSISTANT_API_TOKEN=

# Adresse Gmail surveillée (par défaut gemsofrod@gmail.com)
USER_EMAIL=gemsofrod@gmail.com

# Modèle Anthropic utilisé pour classer les emails et l'agent vocal
ASSISTANT_MODEL=claude-opus-4-8

# Intervalle (secondes) entre deux cycles de triage automatique
TRIAGE_INTERVAL_SECONDS=300

# Requête Gmail utilisée pour repérer les nouveaux emails à trier
TRIAGE_QUERY=in:inbox is:unread
TRIAGE_MAX_RESULTS=20
