# Base de données Postgres. En local, le plus simple est de démarrer juste
# le service Postgres du docker-compose à la racine du dépôt :
#   docker compose up -d postgres
# puis reprendre les mêmes identifiants ici (voir .env.production.example).
DATABASE_URL="postgresql://gemsofrod:change-me@localhost:5432/gemsofrod"

# Secret de session NextAuth — générer avec `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Utilisés uniquement par le script de seed (prisma/seed.ts) pour créer le
# premier compte administrateur. Optionnels : des valeurs par défaut existent.
SEED_ADMIN_EMAIL="gemsofrod@gmail.com"
SEED_ADMIN_PASSWORD="changez-moi-immediatement"
