# Base de données (SQLite en local, Postgres recommandé en production — voir README)
DATABASE_URL="file:./dev.db"

# Secret de session NextAuth — générer avec `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Utilisés uniquement par le script de seed (prisma/seed.ts) pour créer le
# premier compte administrateur. Optionnels : des valeurs par défaut existent.
SEED_ADMIN_EMAIL="gemsofrod@gmail.com"
SEED_ADMIN_PASSWORD="changez-moi-immediatement"
