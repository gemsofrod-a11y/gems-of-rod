# Copier ce fichier en ".env" (à côté de ce fichier) et renseigner
# les valeurs souhaitées. Aucune variable n'est obligatoire : sans
# configuration, l'application fonctionne entièrement avec le broker
# interne (simulation) et un cours simulé si le cours réel n'est pas
# joignable.

# --- OANDA (broker gratuit, compte "practice" = démo) ---
# 1. Créer un compte gratuit sur oanda.com puis un compte "practice"
# 2. Dans le portail de gestion de compte : "Manage API Access" -> générer un jeton
# 3. Récupérer l'identifiant de compte practice (format XXX-XXX-XXXXXXX-XXX)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
OANDA_INSTRUMENT=XAU_USD

# --- eToro (connecteur BÊTA, non vérifié face à la doc officielle — voir
# backend/etoro_connector.py) ---
ETORO_API_KEY=
ETORO_XAU_INSTRUMENT_ID=
ETORO_BASE_URL=https://public-api.etoro.com
